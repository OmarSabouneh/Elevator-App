# Server
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Subscription length when admin activates (days)
SUBSCRIPTION_DAYS=31

# Database — leave unset for local SQLite; set for Supabase PostgreSQL
# DATABASE_URL=postgresql://postgres.[ref]:PASSWORD@....pooler.supabase.com:6543/postgres
# DATABASE_SSL=true
# How often backend automatically pings Supabase (hours, default: 24)
DB_PING_INTERVAL_HOURS=24

# Breaker / switch — mock | http | shelly | tuya
SWITCH_TYPE=mock
ELEVATOR_PULSE_MS=60000

# Tuya (production)
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
# TUYA_REGION=eu
# TUYA_DEVICE_ID=
# TUYA_DP_CODE=switch

# Switch availability monitoring (ms, default: 300000 = 5 minutes)
SWITCH_CHECK_INTERVAL_MS=300000

# Push Notifications (VAPID) — optional, will auto-generate and persist to database if omitted
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@elevator-access.local

# Bootstrap admin — sign in with phone + password
ADMIN_PHONE=+96181464733
ADMIN_PASSWORD=change-me

